# Ignore Markdown and PDF files
*.md
!README.md
!docs/**/*.md
!frontend/**/*.md
!backend/**/*.md
!data/**/*.md
!notebooks/**/*.md
!scripts/**/*.md
!tests/**/*.md
!archive/**/*.md
!artifacts/**/*.md
*.pdf

# Ignore Floramind related files
*floramind*
*FloraMind*
*FLORAMIND*

# Python and Jupyter temporary/cache files
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.env
.ipynb_checkpoints/

# Temp and extraneous directories
_temp_pages/
*.html
runtime_data/
.matplotlib_cache/
var/
